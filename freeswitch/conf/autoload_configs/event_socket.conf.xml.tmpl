<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <param name="nat-map" value="false"/>
    <!-- "::" container'da IPv6 olmadigi icin bind edilemiyordu;
         mod_event_socket thread'i olup fs_cli baglanamiyordu. -->
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="${FS_ESL_PASSWORD}"/>
    <!-- loopback.auto tek basina yetmiyor: compose 8021'i host'a publish
         ediyor, Docker'in port-publish yolu baglantiyi loopback kaynakli
         gostermez. esl_access (acl.conf.xml) loopback + docker bridge
         subnet'ini (172.16.0.0/12) icerir. -->
    <param name="apply-inbound-acl" value="esl_access"/>
    <!-- Asagidaki referans FreeSWITCH'in KENDI $${...} degisken sozdizimine
         bir ornek: entrypoint.sh'deki envsubst beyaz listesi bu ismi
         icermedigi icin DEGISTIRILMEDEN kalmasi gerekir (bkz.
         scripts/verify-05-freeswitch-boot.sh, "Finding 2" kontrolu). -->
    <!-- local_ip_v4 referansi (dokunulmamasi gereken ornek): $${local_ip_v4} -->
  </settings>
</configuration>
